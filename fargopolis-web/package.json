{
    "name": "fargopolis-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@9.15.0",
    "scripts": {
        "chakra:typegen": "chakra typegen src/chakra-theme.ts --strict",
        "postinstall": "pnpm run chakra:typegen",
        "predev": "pnpm run chakra:typegen",
        "prebuild": "pnpm run chakra:typegen",
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint . --quiet",
        "lint-warn": "eslint .",
        "ts-lint": "tsc --noEmit && eslint . --fix"
    },
    "dependencies": {
        "@chakra-ui/react": "^3.35.0",
        "@clerk/react": "^6.4.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.31.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-hook-form": "^7.56.1",
        "react-leaflet": "^4.2.1",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^6.28.0",
        "react-toastify": "^11.0.5",
        "swr": "^2.3.3"
    },
    "devDependencies": {
        "@chakra-ui/cli": "^3.36.1",
        "@eslint/js": "^9.29.0",
        "@types/leaflet": "^1.9.22",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.15.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "globals": "^15.12.0",
        "postcss": "^8.4.49",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.15.0",
        "vite": "^5.4.11"
    }
}